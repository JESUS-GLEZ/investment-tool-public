# =============================================================================
# .env.example — Environment variables for production deployment
#
# New installation: python3 tools/setup_local.py
# This generates independent database/JWT secrets without overwriting .env.
# Use --alpaca to enter hidden provider credentials, including on an existing install.
# Alternatively copy this template and replace both CHANGE_ME values manually.
# Do not regenerate credentials when updating an existing installation.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=investment_tool
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=investment_tool
# The password in this URL must match POSTGRES_PASSWORD. Generated values are
# URL-safe; manually supplied special characters need URL encoding in the URL.
# These hostnames are for Docker, not API/worker processes running on the host.
DATABASE_URL=postgresql://investment_tool:CHANGE_ME_strong_random_password@postgres:5432/investment_tool

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production API startup rejects this placeholder and insufficient HMAC key lengths.
# This signs login tokens; it is not the password for your web account.
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_secret

# ---------------------------------------------------------------------------
# Optional market data credentials (blank is enough to start/register in the UI)
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Retained for compatibility; no current data source uses Alpha Vantage.
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to 'production' in production
ENV=production

# Explicit browser origins for a separately configured host (comma-separated).
# Empty uses the documented localhost/127.0.0.1 defaults.
CORS_ORIGINS=

# Heavy backtests run serially by default to bound RAM on a small Docker VM.
WORKER_CONCURRENCY=1
# Numerical threads per Celery process; avoids competing NumPy/SciPy pools.
WORKER_BLAS_THREADS=1
